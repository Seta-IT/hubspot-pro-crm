{
  "name": "crm-hubspot-pro",
  "version": "1.0.0",
  "description": "CRM HubSpot Pro - Backend, Database, Data Health, Enrichment & Workflow Engine",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:web": "next build",
    "start": "tsc -p tsconfig.build.json && node dist/src/api/server.js",
    "start:web": "next start -p ${PORT:-3000}",
    "dev": "next dev -p 3000",
    "db:migrate": "tsc -p tsconfig.build.json && node dist/src/db/cli-migrate.js",
    "db:migrate:setadesk": "tsc -p tsconfig.build.json && node dist/src/db/setadesk-migrate.js",
    "db:seed": "tsc -p tsconfig.build.json && node dist/src/db/cli-migrate.js --seed",
    "prisma:push": "npx prisma db push",
    "test": "tsc -p tsconfig.build.json && rm -f /tmp/stihub-test-resend-attempts.log /tmp/stihub-test-cnpj-mocked.log /tmp/stihub-test-net-blocked.log && NODE_ENV=test NODE_OPTIONS=--import=./dist/tests/setup/no-network.js node --test dist/tests/*.test.js && node dist/tests/setup/assert-no-resend.js"
  },
  "keywords": [
    "crm",
    "hubspot",
    "data-health",
    "enrichment",
    "workflows",
    "typescript"
  ],
  "author": "Atlas Backend",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "lucide-react": "^1.61.0",
    "next": "^14.2.25",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  }
}
