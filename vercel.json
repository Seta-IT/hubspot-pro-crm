{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build && npm run build:web",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/erp/daily-sync",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/crm/proposal-followup",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/tickets/email-intake/poll",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/sequences",
      "schedule": "*/15 * * * 1-5"
    },
    {
      "path": "/api/cron/marketing",
      "schedule": "*/5 * * * *"
    }
  ]
}
