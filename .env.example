# ============================================================================
# HubSpot Pro CRM - Variáveis de Ambiente de Produção
# ============================================================================

# Conexão PostgreSQL (Supabase, Neon, Railway, Render ou Docker local)
# Quando DATABASE_URL está definida, o CRM ativa automaticamente o modo PostgreSQL
# (com snapshot transacional JSONB + tabelas relacionais espelhadas para SQL/BI).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hubspot_pro_crm?schema=public"
# Neon (gravadas por `neon env pull`/`neon deploy` em .env.local, nunca commitar):
#   DATABASE_URL          -> conexao pooled (host com -pooler), usada pelo app
#   DATABASE_URL_UNPOOLED -> conexao direta, usada so pelos CLIs de migracao (db:migrate)
DATABASE_URL_UNPOOLED=""

# Porta HTTP da aplicação Next.js
PORT=3000

# Ambiente de execução
NODE_ENV=production

# (Opcional) Caminho de fallback local caso DATABASE_URL não seja utilizado
CRM_STORE_PATH=".data/crm-store.json"

# ============================================================================
# Integração Oficial ERP GestãoClick / Seta Telecom (Credencial ERP-GROK)
# ============================================================================
GESTAOCLICK_ACCESS_TOKEN="seu_access_token_gestaoclick_aqui"
GESTAOCLICK_SECRET_ACCESS_TOKEN="seu_secret_access_token_gestaoclick_aqui"
GESTAOCLICK_API_URL="https://api.gestaoclick.com/api"
GESTAOCLICK_MCP_URL="https://api.gestaoclick.com/v1/mcp"

# Segredo Criptográfico de Sessão Corporativa STI-hub (HMAC-SHA256 / 32+ bytes)
STI_HUB_SESSION_SECRET="gere_uma_chave_secreta_aleatoria_de_64_caracteres_hex_aqui"

# ============================================================================
# Plataforma (Vercel -> Cloud Run). Ver docs/CLOUD_RUN_MIGRATION.md
# ============================================================================

# Origem publica https (obrigatoria em producao). Sem ela, CORS, convites,
# links de proposta/fatura e OAuth/MCP falham fechados — em producao o Host
# da requisicao NÃO e usado como fallback.
STI_HUB_PUBLIC_ORIGIN="https://sti-hub.setatelecom.com.br"

# Cookie Secure: em producao fica SEMPRE ligado (SECURE_COOKIES=0 e ignorado).
# Fora de producao: 1/true liga, 0/false desliga.
# SECURE_COOKIES="1"

# Proxy confiavel para o IP do cliente: vercel | cloudrun | none
# Sem a variavel: vercel se VERCEL=1; cloudrun se K_SERVICE ou CLOUD_RUN_JOB;
# senao none (fail-closed). Com K_SERVICE/CLOUD_RUN_JOB, vercel e recusado
# (X-Real-IP e forjavel) e o modo vira cloudrun. none explicito permanece.
# TRUSTED_PROXY_MODE="cloudrun"

# Quantos proxies contar a partir da DIREITA no X-Forwarded-For (Cloud Run).
# Padrao 1: so o Google Front End (URL run.app). Use 2 quando houver load
# balancer HTTPS externo na frente do Cloud Run (GFE + LB). Nunca use a
# primeira entrada (o cliente controla).
# TRUSTED_PROXY_HOPS="1"

# OIDC do Cloud Scheduler (preferencial). apply.sh usa a SA e a audience;
# NAO passa CRON_SECRET na linha de comando.
# CRON_OIDC_SERVICE_ACCOUNT="sti-hub-scheduler@PROJECT.iam.gserviceaccount.com"
# CRON_OIDC_AUDIENCE="https://sti-hub.setatelecom.com.br"

# Bearer legado, so compatibilidade da migracao Vercel. Minimo 16 caracteres.
# CRON_SECRET="gere_um_segredo_aleatorio_com_pelo_menos_16_caracteres"
