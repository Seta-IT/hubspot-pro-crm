# ============================================================================
# HubSpot Pro CRM - Variáveis de Ambiente de Produção
# ============================================================================

# Conexão PostgreSQL (Supabase, Neon, Railway, Render ou Docker local)
# Quando DATABASE_URL está definida, o CRM ativa automaticamente o modo PostgreSQL
# (com snapshot transacional JSONB + tabelas relacionais espelhadas para SQL/BI).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hubspot_pro_crm?schema=public"

# Porta HTTP da aplicação Next.js
PORT=3000

# Ambiente de execução
NODE_ENV=production

# (Opcional) Caminho de fallback local caso DATABASE_URL não seja utilizado
CRM_STORE_PATH=".data/crm-store.json"

# ============================================================================
# Integração Oficial ERP GestãoClick / Seta Telecom (Credencial ERP-GROK)
# ============================================================================
GESTAOCLICK_ACCESS_TOKEN="seu_access_token_gestaoclick_aqui"
GESTAOCLICK_SECRET_ACCESS_TOKEN="seu_secret_access_token_gestaoclick_aqui"
GESTAOCLICK_API_URL="https://api.gestaoclick.com/api"
GESTAOCLICK_MCP_URL="https://api.gestaoclick.com/v1/mcp"

# Segredo Criptográfico de Sessão Corporativa STI-hub (HMAC-SHA256 / 32+ bytes)
STI_HUB_SESSION_SECRET="gere_uma_chave_secreta_aleatoria_de_64_caracteres_hex_aqui"
