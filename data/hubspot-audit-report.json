  "actionableImprovementsForHubSpotProCrm": [
    {
      "id": "imp-1",
      "category": "Identidade & Proprietários Reais (Seta Telecom)",
      "title": "Substituir proprietários fictícios pelos 3 Owners ativos reais da Seta Telecom + Reatribuição de carteira legada",
      "details": "O portal 4369067 (Seta Telecom LTDA) possui 3 owners ativos (Marcelo Lopes Mira [31598215], Evelyn Ternero Seta Telecom [77388429] e Contato Seta Telecom [237730683]) e 41 ex-colaboradores/inativos (como (Inside) Gabriel Lopes, Negócios Seta Telecom, Karis Marketing, Felipe Seta, etc.). Podemos pré-carregar esses proprietários reais no HubSpot Pro CRM e criar uma ferramenta no Data Health de 'Reatribuição em 1 Clique de Registros de Ex-Vendedores Inativos'."
    },
    {
      "id": "imp-2",
      "category": "Propriedades Nativas HubSpot & ABM",
      "title": "Incorporar campos executivos do Schema HubSpot da Seta Telecom em Contatos, Empresas e Negócios",
      "details": "Adicionar em Contatos: hs_buying_role (Papel de Compra: Decisor, Influenciador, Comprador, Bloqueador), hs_persona, hs_is_unworked (Lead Intocado) e hs_time_to_first_engagement (SLA de 1º atendimento). Adicionar em Empresas: hs_is_target_account (Conta Alvo ABM), hs_ideal_customer_profile (Tier ICP 1/2/3) e type (Prospect, Parceiro, Cliente, Revendedor). Adicionar em Negócios: dealtype (Novo Negócio vs. Upsell/Renovação), hs_priority (Alta/Média/Baixa), closed_won_reason e closed_lost_reason, além de suporte a multi-moeda BRL + USD."
    },
    {
      "id": "imp-3",
      "category": "Edição 360° Completa em Todos os Módulos",
      "title": "Adicionar Edição Completa de Negócios (Deals) e de Chamados (Tickets) além de Contatos e Empresas",
      "details": "Contatos e Empresas já contam com edição e exclusão completas. No entanto, no modal/drawer de Negócios (DealsKanbanTab) hoje só é possível mudar o estágio e adicionar nota — precisamos permitir editar Título, Valor (R$/US$), Data de Fechamento, Proprietário, Empresa/Contato vinculado, Tipo de Negócio, Prioridade e Motivo de Ganho/Perda, além de excluir negócio. No Service Desk (ServiceDeskTab), adicionar edição de Prioridade, Categoria, Responsável e Resolução (hs_resolution)."
    },
    {
      "id": "imp-4",
      "category": "Catálogo Telecom, Propostas (Quotes) e Receita Recorrente (MRR/ARR/TCV)",
      "title": "Suporte a Produtos, Line Items Recorrentes (MRR/ARR) e Cotações no Negócio",
      "details": "Como a Seta Telecom opera no setor de Telecomunicações e TI B2B, o schema do HubSpot dela inclui PRODUCT, LINE_ITEM (hs_recurring_billing_period, hs_tcv, hs_arr), SUBSCRIPTION (hs_mrr) e QUOTE. Adicionar nos Negócios a composição de itens/planos recorrentes (MRR, ARR, Prazo Contratual em meses) e gerador rápido de Proposta Comercial (Quote)."
    },
    {
      "id": "imp-5",
      "category": "Segmentos Dinâmicos (Active Lists) & Filtros Avançados",
      "title": "Criar Barra de Segmentos Salvos (Listas Ativas/Estáticas) e Filtro por Proprietário e Papel de Compra",
      "details": "Reproduzir o OBJECT_LIST (Segmentos do HubSpot) dentro da aba de Contatos & Empresas com filtros rápidos pré-configurados: 'Meus Contatos (Marcelo Mira)', 'Carteira Evelyn Ternero', 'Leads Intocados (hs_is_unworked)', 'Decisores C-Level sem Deal', 'Contas Alvo (Target Accounts ABM)' e 'Órfãos de Ex-Vendedores Inativos'."
    },
    {
      "id": "imp-6",
      "category": "Sincronizador Real Seta Telecom (Portal 4369067)",
      "title": "Atualizar o Assistente de Migração HubSpot com os metadados reais do Portal 4369067 (Seta Telecom LTDA)",
      "details": "Conectar o migrador em /api/migration/hubspot aos dados reais auditados da Seta Telecom LTDA (Hub ID 4369067, Moeda BRL/USD, Timezone America/Sao_Paulo, Owners ativos e inativos reais) e permitir importação direta via API/CSV/JSON assim que os escopos crm.objects.*.read forem marcados."
    }
  ]
